<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <Platforms>x86;x64;ARM64;AnyCPU</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>

    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <RootNamespace>PMortara.Helpers.ImageConverterExtensions</RootNamespace>
    
    <Title>Image converter extensions</Title>
    <Authors>Patrick Mortara</Authors>
    <Description>A small library of extensions to convert images between different formats.</Description>
    <Copyright>2024 Patrick Mortara</Copyright>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="Emgu.CV.Bitmap" Version="4.13.0.5924" />
	  <PackageReference Include="Emgu.CV.Wpf" Version="4.13.0.5924" />
	  <PackageReference Include="Imageflow.Net" Version="0.15.1" />
	  <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.15.0" />
	  <PackageReference Include="Magick.NET.Core" Version="14.15.0" />
	  <PackageReference Include="SixLabors.ImageSharp" Version="4.0.0" />
	  <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.150.0" />
	  <PackageReference Include="SkiaSharp.NativeAssets.WinUI" Version="4.150.0" />
	  <PackageReference Include="SkiaSharp.Views.Desktop.Common" Version="4.150.0" />
	  <PackageReference Include="SkiaSharp.Views.WindowsForms" Version="4.150.0" />
    <PackageReference Include="SkiaSharp.Views.WinUI" Version="4.150.0" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="4.150.0" />
	  <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
	  <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
	  <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
	  <PackageReference Include="System.Private.Uri" Version="4.3.2" />
	  <PackageReference Include="System.Text.Json" Version="10.0.9" />
  </ItemGroup>

</Project>
